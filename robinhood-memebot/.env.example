# --- Chain ---
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
UNISWAP_V3_FACTORY=0x1f7d7550B1b028f7571E69A784071F0205FD2EfA
POLL_INTERVAL=5
# Blocks per eth_getLogs request when catching up
MAX_BLOCK_RANGE=500
# Optional: start scanning from this block instead of the current head
# START_BLOCK=

# --- Quote tokens (REQUIRED for liquidity_usd) ---
# Comma-separated address:kind pairs. kind = usd (stablecoin, ~$1) or eth (priced via ETH_USD_PRICE).
# Look the addresses up yourself; none are assumed. A pool with no recognised quote token gets
# liquidity_usd = 0 and is skipped by the liquidity gate.
QUOTE_TOKENS=
ETH_USD_PRICE=0
# Treat a token with no owner() function as "renounced". Default false = fail closed.
TREAT_NO_OWNER_AS_RENOUNCED=false

# --- Decision engine (Jev) ---
TYPESAFE_API_KEY=

# --- Hard gates (applied in code, after the decision engine) ---
MIN_LIQUIDITY_USD=20000
MIN_CONFIDENCE=0.70
MAX_RISK_SCORE=4

# --- Paper trading ---
PAPER_POSITION_USD=100
DATA_DIR=data
